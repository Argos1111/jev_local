+    // Sarashina uses Python's ties-to-even rounding and double-precision size calculations.
+    static clip_image_size calc_size_sarashina(const clip_image_size & size, const calc_size_opt & opts) {
+        const int w = size.width;
+        const int h = size.height;
+        if (w <= 0 || h <= 0 || std::max(w, h) > 200.0 * std::min(w, h)) {
+            throw std::runtime_error("Sarashina image aspect ratio must not exceed 200");
+        }
+        const int f = opts.align_size;
+        auto round_even = [f](int value) {
+            const int q = value / f;
+            const int r = value % f;
+            return (q + (2*r > f || (2*r == f && q % 2 != 0))) * f;
+        };
+        int wb = round_even(w);
+        int hb = round_even(h);
+        const double area = static_cast<double>(w) * h;
+        if (static_cast<double>(wb) * hb > opts.max_pixels) {
+            const double beta = std::sqrt(area / opts.max_pixels);
+            wb = std::max(f, static_cast<int>(std::floor(w / beta / f)) * f);
+            hb = std::max(f, static_cast<int>(std::floor(h / beta / f)) * f);
+        } else if (static_cast<double>(wb) * hb < opts.min_pixels) {
+            const double beta = std::sqrt(opts.min_pixels / area);
+            wb = static_cast<int>(std::ceil(w * beta / f)) * f;
+            hb = static_cast<int>(std::ceil(h * beta / f)) * f;
+        }
+        return {wb, hb};
+    }
