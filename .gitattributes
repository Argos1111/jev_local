# Unified diffs use a single space for empty context lines, including at EOF.
native/*.patch whitespace=-blank-at-eol,-blank-at-eof
# Preserve checksum-pinned third-party texts, including upstream whitespace/CRLF.
licenses/LICENSE.* -text whitespace=-blank-at-eol,-blank-at-eof
licenses/runtime/LICENSE.* -text whitespace=-blank-at-eol,-blank-at-eof
licenses/runtime/GCC-* -text whitespace=-blank-at-eol,-blank-at-eof
licenses/runtime/NOTICE.* -text whitespace=-blank-at-eol,-blank-at-eof
